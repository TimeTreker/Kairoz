{
  "name": "kairoz",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "npm run dev -w @kairoz/prototype",
    "build": "npm run build -w @kairoz/prototype",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  }
}
