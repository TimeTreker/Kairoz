{
  "name": "@kairoz/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "migrate": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts",
    "seed:demo": "node --env-file-if-exists=../../.env src/demo/seed-cli.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=4 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
